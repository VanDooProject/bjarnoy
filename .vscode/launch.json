   "version": "0.2.0",
   "configurations": [
        //{
        //    "name": "Launch Frontend",
        //    "type": "node",
        //    "request": "launch",
        //    "cwd": "${workspaceFolder}/Frontend",
        //    "runtimeExecutable": "npm",
        //    "runtimeArgs": [
        //        "run",
        //        "dev"
        //    ],
        //    // "port": 9229,
        //    "autoAttachChildProcesses": true,
        //},
        // https://github.com/marckassay/VSCodeNewProject/blob/master/.vscode/launch.json
        // Docs: https://github.com/Microsoft/vscode-chrome-debug
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Frontend in Chrome Debugger",
            "port": 9222,
            "url": "http://localhost:8080/",
            "cwd": "${workspaceFolder}/Frontend",
            "webRoot": "${workspaceRoot}/Frontend",
            "sourceMapPathOverrides": {
            //    "webpack:///.": "${workspaceRoot}/Frontend/",
                "webpack:///./*": "${workspaceRoot}/Frontend/*",
                "webpack:///./js/*": "${workspaceRoot}/Frontend/js/*",
                "webpack:///js/*": "${workspaceRoot}/Frontend/js/*",
                "webpack:///./js/components/*": "${workspaceRoot}/Frontend/js/components/*",
                "webpack:///js/components/*": "${workspaceRoot}/Frontend/js/components/*",
            },
            "sourceMaps": true,
            "timeout": 10000,
        //    "trace":"verbose",
            "preLaunchTask": "watch", // => npm run dev
        },
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/Backend/ApiServer/bin/Debug/netcoreapp2.0/ApiServer.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Backend/ApiServer",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart",
            "launchBrowser": {
                "enabled": true,
                "args": "${auto-detect-url}/swagger",
                "windows": {
                    "command": "cmd.exe",
                    "args": "/C start ${auto-detect-url}/swagger"
                },
                "osx": {
                    "command": "open"
                },
                "linux": {
                    "command": "xdg-open"
                }
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ,
        {
            "name": "Attach to ClearScript V8 on port 9222",
            "type": "node",
            "request": "attach",
            "protocol": "inspector",
            "address": "localhost",
            "port": 9222
        }
    ]
}