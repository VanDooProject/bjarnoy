# Used only for `docker compose up` outside Coolify. In Coolify, set these
# as the Service's environment variables instead — ACCESS_TOKEN is a secret
# and should never be committed to a .env file that gets checked in.

# A classic PAT with admin:org scope (org-level runner registration needs
# this; a repo-scoped token isn't enough even with RUNNER_SCOPE=org).
ACCESS_TOKEN=

RUNNER_SCOPE=org
ORG_NAME=VanDooProject

# Unused for RUNNER_SCOPE=org — only relevant if this ever switches to
# RUNNER_SCOPE=repo.
REPO_URL=

RUNNER_NAME_PREFIX=coolify-runner
LABELS=self-hosted,gpu
