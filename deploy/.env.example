# Only needed to run deploy/docker-compose.yaml by hand. Coolify generates
# every SERVICE_* value itself on the first deployment and stores it with the
# resource — do not set those in Coolify's environment variables.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yaml --project-directory . \
#     --env-file deploy/.env up --build

SERVICE_PASSWORD_POSTGRES=change-me-postgres
SERVICE_BASE64_64_JWT=change-me-to-a-long-random-string-not-this-one
SERVICE_PASSWORD_ADMIN=change-me-admin
ADMIN_BOOTSTRAP_USERNAME=admin
