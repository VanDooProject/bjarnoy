<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

    <!--
      Both providers live here rather than in the host, so the one place that
      knows the model also knows which dialects it must stay portable across.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />

    <!-- UserActivityService's per-user write-throttle. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />

    <!-- FogMaskPngEncoder's RGBA8 -> PNG encode. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bjarnoy.Domain\Bjarnoy.Domain.csproj" />
  </ItemGroup>

</Project>
