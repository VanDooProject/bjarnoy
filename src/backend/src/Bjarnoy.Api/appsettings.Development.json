{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // The AppHost runs this API (and the migrator) with
      // ASPNETCORE_ENVIRONMENT=Development, so this file is also what the
      // aspire-e2e job's API process logs at — and every line it writes is
      // relayed into that job's log twice over (once as the child's own line,
      // once wrapped by Bjarnoy.AppHost.Resources.api). "Applying migration
      // 'X'" for all ~40 migrations, on every one of the nine tests' fresh
      // databases, is by far the biggest single contributor there and says
      // nothing a failing test needs. DatabaseMigrator's own start/finish
      // lines (Bjarnoy.Infrastructure.*, untouched here) still report that the
      // batch ran, and a migration that actually *fails* logs at Error.
      "Microsoft.EntityFrameworkCore.Migrations": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=bjarnoy.dev.db",
    "MigrateOnStartup": true
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-not-for-production-use-change-me-0123456789"
  }
}
