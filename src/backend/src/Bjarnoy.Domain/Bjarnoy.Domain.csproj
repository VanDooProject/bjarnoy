<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The domain deliberately has no package references: world generation, hex
    maths and game rules must be testable without a host, a database or a
    clock. Anything ambient (time, randomness, configuration) is passed in.
  -->

  <ItemGroup>
    <!-- Lets Bjarnoy.Domain.Tests assert directly against internal generator
         constants (e.g. GiantGenerator's placement thresholds) instead of
         duplicating their values as magic numbers in the test suite. -->
    <InternalsVisibleTo Include="Bjarnoy.Domain.Tests" />
  </ItemGroup>

</Project>
