          "maxPlayers": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EntityId": {
        "type": "string"
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": null,
            "nullable": true
          }
        }
      },
      "JoinWorldRequest": {
        "required": [
