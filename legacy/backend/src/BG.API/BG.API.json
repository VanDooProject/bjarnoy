        "properties": {
          "id": {
            "$ref": "#/components/schemas/EntityId"
          },
          "name": {
            "type": "string"
          },
          "maxPlayers": {
            "type": "integer",
            "format": "int32"
          },
          "currentPlayerCount": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/WorldStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorldStatus": {
        "type": "integer",
        "x-enum-varnames": [
          "Active",
          "Maintenance",
          "Full",
          "Ended"
        ],
        "x-enum-descriptions": [
          null,
          null,
          null,
          "game over"
        ],
        "enum": [
          0,
          1,
          2,
          3
        ]
      }
    }
  },
